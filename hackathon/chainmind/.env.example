# ChainMind local environment template.
# Copy this file to .env and fill real values locally.
# Do not commit .env.

DUNE_API_KEY=

# Fill these after creating the saved queries in Dune.
DUNE_QUERY_TOKEN_TRADING_ACTIVITY=
DUNE_QUERY_FIVE_MINUTE_FLOW=
DUNE_QUERY_EARLY_BUYERS=
DUNE_QUERY_EARLY_BUYER_FUNDING=

# DexScreener API.
# No API key is required for the current REST market snapshot integration.
# Current usage: token pair market/liquidity/volume data.
DEXSCREENER_BASE_URL=https://api.dexscreener.com

# GoPlus Security API.
# Current usage: token security flags, owner/renounce status, holder concentration hints.
# Planned security endpoints:
# - Token security: /api/v1/token_security/{chain_id}
# - Malicious address: /api/v1/address_security/{address}
# - Token approvals: /api/v2/token_approval_security/{chain_id}
# - Phishing site: /api/v1/phishing_site
# - Transaction simulation: /api/v1/transaction_simulation
# Leave GOPLUS_ACCESS_TOKEN empty if your GoPlus plan does not require authentication.
GOPLUS_BASE_URL=https://api.gopluslabs.io
GOPLUS_ACCESS_TOKEN=

# Honeypot.is API.
# Planned usage: buy/sell simulation and honeypot evidence.
# No key is usually required for public endpoints.
HONEYPOT_BASE_URL=https://api.honeypot.is

# BNB Chain RPC.
# Current usage: direct on-chain reads such as owner(), totalSupply(), buyTaxRate(), sellTaxRate().
# Recommended: use a private RPC provider URL for stable rate limits.
# Important: this URL must point to BNB Chain. eth_chainId should return 0x38.
BNB_RPC_URL=

# Etherscan V2 / BNB Chain holder API.
# Planned usage: token holder list and address-level enrichment.
# For BNB Chain through Etherscan V2, keep ETHERSCAN_CHAIN_ID=56.
# Note: Etherscan V2 may require a paid plan for full BNB Chain coverage.
# If the API returns "Free API access is not supported for this chain",
# use a supported plan or switch this explorer integration to BscScan.
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
ETHERSCAN_API_KEY=
ETHERSCAN_CHAIN_ID=56

# Nansen API.
# Planned usage: smart money flows, token holder intelligence, address labels,
# token god mode data, and wallet/entity enrichment.
# Auth header required by Nansen: apikey: <NANSEN_API_KEY>
# Use V1 endpoints. The old /api/beta endpoints are deprecated.
NANSEN_BASE_URL=https://api.nansen.ai/api/v1
NANSEN_API_KEY=
NANSEN_CHAIN=bnb

# GMGN API.
# Usage: optional market/trending/signal data source for future ChainMind enrichment.
# Fill GMGN_API_KEY with the key created at https://gmgn.ai/ai?chain=bsc&tab=api_management.
# Keep the Ed25519 private key local. Prefer storing it as a PEM file and referencing the path below.
GMGN_API_KEY=
GMGN_CLI_COMMAND=gmgn-cli
GMGN_PRIVATE_KEY_PATH=runtime/keys/gmgn_ed25519_private.pem
GMGN_CHAIN=bsc
